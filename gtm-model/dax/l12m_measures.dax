// =============================================================================
// GTM - L12M (rolling last 12 months) measures and axis table. BU page.
// Moved out of measures.dax (2026-11-02). Measures belong to table MPO,
// display folder "10. L12M". Untested in Power BI.
//
// BUILD STEPS
// 1. Modeling > New table: paste the 'L12M Axis' definition below (or use
//    l12m_axis.tmdl). NO relationships. Sort Month Label by Month Sort Key;
//    hide Month Sort Key. Fallback: same 3 columns as an Import Power Query table.
// 2. Add the 6 measures below to MPO, folder 10. L12M.
// 3. BU page: clustered column chart, X = 'L12M Axis'[Month Label] (ascending,
//    drill off), Y = L12M Planned / L12M Executed / L12M Activities With Sales.
// 4. Keep the Month slicer on DimDate. Visual filter: L12M Visible Flag = 1.
// 5. Optional: Columns > fx > Field value > L12M Bar Colour (single-series only).
// 6. Test: Aug 2026 selected -> Sep 2025 .. Aug 2026, Aug last.
// =============================================================================

// ---- Calculated table -------------------------------------------------------
/*
'L12M Axis' =
VAR _Months =
    DISTINCT (
        SELECTCOLUMNS (
            DimDate,
            "Month Start", DATE ( YEAR ( DimDate[ACTUAL_DATE] ), MONTH ( DimDate[ACTUAL_DATE] ), 1 )
        )
    )
RETURN
    ADDCOLUMNS (
        _Months,
        "Month Label", FORMAT ( [Month Start], "mmm yyyy" ),
        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] )
    )
*/

// ---- Measures (TMDL, table MPO) ---------------------------------------------
	// ---------------------------------------------------------------------------
	// 10. L12M - rolling last 12 months on the disconnected 'L12M Axis' table (BU page).
	// The Month slicer stays on DimDate; these measures remove the DimDate filter and
	// re-apply the axis month as a date range. Planned date except L12M Executed (exec date).
	// ---------------------------------------------------------------------------

	/// End date of the selected DimDate month (max selected). With no date filter: end of the month of [Data Through Date].
	measure 'L12M Selected Month End' =
			IF (
			    ISFILTERED ( DimDate ),
			    EOMONTH ( MAX ( DimDate[ACTUAL_DATE] ), 0 ),
			    EOMONTH ( CALCULATE ( [Data Through Date], REMOVEFILTERS ( DimDate ) ), 0 )
			)
		formatString: d mmm yyyy
		displayFolder: 10. L12M

	/// 1 when the axis month is one of the 12 months ending at the selected month, else 0.
	measure 'L12M Visible Flag' =
			VAR _End       = [L12M Selected Month End]
			VAR _Start     = DATE ( YEAR ( _End ), MONTH ( _End ) - 11, 1 )
			VAR _AxisMonth = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF ( NOT ISBLANK ( _AxisMonth ) && _AxisMonth >= _Start && _AxisMonth <= _End, 1, 0 )
		formatString: 0
		displayFolder: 10. L12M

	/// Planned Activities for the axis month, only inside the 12 months ending at the selected month; planned date.
	measure 'L12M Planned' =
			VAR _AxisMonth = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Planned Activities],
			            REMOVEFILTERS ( DimDate ),
			            DATESBETWEEN ( DimDate[ACTUAL_DATE], _AxisMonth, EOMONTH ( _AxisMonth, 0 ) )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// Executed (Exec Date) for the axis month (USERELATIONSHIP on ExecutedDateKey), only inside the 12-month window.
	measure 'L12M Executed' =
			VAR _AxisMonth = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Executed Activities],
			            REMOVEFILTERS ( DimDate ),
			            DATESBETWEEN ( DimDate[ACTUAL_DATE], _AxisMonth, EOMONTH ( _AxisMonth, 0 ) ),
			            USERELATIONSHIP ( DimDate[DATE_KEY], MPO[ExecutedDateKey] )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// PROVISIONAL. Activities With Sales for the axis month, only inside the 12-month window; planned date.
	measure 'L12M Activities With Sales' =
			// PROVISIONAL (Activities With Sales)
			VAR _AxisMonth = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Activities With Sales],
			            REMOVEFILTERS ( DimDate ),
			            DATESBETWEEN ( DimDate[ACTUAL_DATE], _AxisMonth, EOMONTH ( _AxisMonth, 0 ) )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// Bar colour (fx > Field value): #006341 for the selected month, grey for the other 11.
	measure 'L12M Bar Colour' =
			VAR _End       = [L12M Selected Month End]
			VAR _AxisMonth = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF ( _AxisMonth = DATE ( YEAR ( _End ), MONTH ( _End ), 1 ), "#006341", "#A6A6A6" )
		displayFolder: 10. L12M

