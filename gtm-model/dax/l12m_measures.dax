// =============================================================================
// GTM - L12M (rolling last 12 months) on a 'Month Anchor' table. BU page.
// Reworked 2026-11-02 (user request). Replaces the old 'L12M Axis' approach
// (l12m_axis.tmdl is SUPERSEDED). Measures belong to table MPO, folder
// "10. L12M". Counts only. Untested in Power BI.
//
// TABLES (both disconnected: NO relationships)
//   'Month Anchor' - one row per month. Drives the Year and Month slicers.
//   'L12M Axis'    - one row per month, separate copy for the chart X axis.
//                    It must be separate: a slicer on 'Month Anchor' would cut
//                    the axis down to the one selected month.
//   Axis label = 'L12M Axis'[Axis Label]: the short month name ("Aug") plus
//   N invisible zero-width spaces (N = years after the first year), so
//   "Aug" 2025 and "Aug" 2026 are different values that LOOK the same.
//   Sorted by Month Sort Key (YYYYMM), so the axis is always chronological.
//   The visual filter [L12M Visible Flag] = 1 keeps only the 12 months.
//
// BUILD STEPS: see measures_guide.md section 10 (same as the report-back).
// =============================================================================

// ---- Calculated table 1: 'Month Anchor' (Modeling > New table) ---------------
/*
Month Anchor =
VAR _Months =
    DISTINCT (
        SELECTCOLUMNS (
            DimDate,
            "Month Start", DATE ( YEAR ( DimDate[ACTUAL_DATE] ), MONTH ( DimDate[ACTUAL_DATE] ), 1 )
        )
    )
VAR _TodayIdx = YEAR ( TODAY () ) * 12 + MONTH ( TODAY () )
RETURN
    ADDCOLUMNS (
        _Months,
        "Year", YEAR ( [Month Start] ),
        "Month Number", MONTH ( [Month Start] ),
        "Month Short", FORMAT ( [Month Start], "mmm" ),
        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
        "Relative Month Index", YEAR ( [Month Start] ) * 12 + MONTH ( [Month Start] ) - _TodayIdx
    )
*/
// Column settings: Month Short -> Sort by column = Month Number.
// Relative Month Index: 0 = current calendar month AT REFRESH, -1 = previous, etc.

// ---- Calculated table 2: 'L12M Axis' (Modeling > New table) ------------------
/*
L12M Axis =
VAR _Months =
    DISTINCT (
        SELECTCOLUMNS (
            DimDate,
            "Month Start", DATE ( YEAR ( DimDate[ACTUAL_DATE] ), MONTH ( DimDate[ACTUAL_DATE] ), 1 )
        )
    )
VAR _FirstYear = MINX ( _Months, YEAR ( [Month Start] ) )
RETURN
    ADDCOLUMNS (
        _Months,
        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
        "Axis Label",
            FORMAT ( [Month Start], "mmm" )
                & REPT ( UNICHAR ( 8203 ), YEAR ( [Month Start] ) - _FirstYear )
    )
*/
// Column settings: Axis Label -> Sort by column = Month Sort Key; hide Month Sort Key.

// ---- TMDL versions of the two tables -----------------------------------------
/*
table 'Month Anchor'
	lineageTag: month-anchor

	column 'Month Start'
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: [Month Start]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Number]

	column 'Month Short'
		dataType: string
		summarizeBy: none
		sourceColumn: [Month Short]
		sortByColumn: 'Month Number'

	column 'Month Sort Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Sort Key]

	column 'Relative Month Index'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Relative Month Index]

	partition 'Month Anchor' = calculated
		mode: import
		source =
				VAR _Months = DISTINCT ( SELECTCOLUMNS ( DimDate, "Month Start", DATE ( YEAR ( DimDate[ACTUAL_DATE] ), MONTH ( DimDate[ACTUAL_DATE] ), 1 ) ) )
				VAR _TodayIdx = YEAR ( TODAY () ) * 12 + MONTH ( TODAY () )
				RETURN
				    ADDCOLUMNS ( _Months,
				        "Year", YEAR ( [Month Start] ),
				        "Month Number", MONTH ( [Month Start] ),
				        "Month Short", FORMAT ( [Month Start], "mmm" ),
				        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
				        "Relative Month Index", YEAR ( [Month Start] ) * 12 + MONTH ( [Month Start] ) - _TodayIdx )

table 'L12M Axis'
	lineageTag: l12m-axis

	column 'Month Start'
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: [Month Start]

	column 'Month Sort Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Sort Key]

	column 'Axis Label'
		dataType: string
		summarizeBy: none
		sourceColumn: [Axis Label]
		sortByColumn: 'Month Sort Key'

	partition 'L12M Axis' = calculated
		mode: import
		source =
				VAR _Months = DISTINCT ( SELECTCOLUMNS ( DimDate, "Month Start", DATE ( YEAR ( DimDate[ACTUAL_DATE] ), MONTH ( DimDate[ACTUAL_DATE] ), 1 ) ) )
				VAR _FirstYear = MINX ( _Months, YEAR ( [Month Start] ) )
				RETURN
				    ADDCOLUMNS ( _Months,
				        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
				        "Axis Label", FORMAT ( [Month Start], "mmm" ) & REPT ( UNICHAR ( 8203 ), YEAR ( [Month Start] ) - _FirstYear ) )
*/

// ---- Measures (TMDL, table MPO) ---------------------------------------------
table MPO

	/// Start of the latest month with planned activities (ignores all date and anchor filters).
	measure 'L12M Latest Data Month' =
			VAR _Through = CALCULATE ( [Data Through Date], REMOVEFILTERS ( DimDate ) )
			RETURN
			    IF ( NOT ISBLANK ( _Through ), DATE ( YEAR ( _Through ), MONTH ( _Through ), 1 ) )
		formatString: mmm yyyy
		displayFolder: 10. L12M

	/// Start of the selected anchor month: the latest selected month up to the latest data month (a month-only pick such as "Dec" uses the latest Dec with data). Nothing selected -> latest data month.
	measure 'L12M Selected Month' =
			VAR _Latest = [L12M Latest Data Month]
			VAR _SelUpToLatest =
			    CALCULATE ( MAX ( 'Month Anchor'[Month Start] ), KEEPFILTERS ( 'Month Anchor'[Month Start] <= _Latest ) )
			RETURN
			    IF (
			        ISFILTERED ( 'Month Anchor' ),
			        COALESCE ( _SelUpToLatest, MAX ( 'Month Anchor'[Month Start] ) ),
			        _Latest
			    )
		formatString: mmm yyyy
		displayFolder: 10. L12M

	/// 1 when the axis month is one of the 12 months ending at the selected month (position 12 = selected), else 0. Use as visual filter = 1.
	measure 'L12M Visible Flag' =
			VAR _Sel   = [L12M Selected Month]
			VAR _Start = EDATE ( _Sel, -11 )
			VAR _Axis  = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF ( NOT ISBLANK ( _Axis ) && _Axis >= _Start && _Axis <= _Sel, 1, 0 )
		formatString: 0
		displayFolder: 10. L12M

	/// Position 1..12 of the axis month in the window (12 = selected month); blank outside. For tooltips / QA.
	measure 'L12M Position' =
			VAR _Sel  = [L12M Selected Month]
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			VAR _Pos  = 12 - ( ( YEAR ( _Sel ) * 12 + MONTH ( _Sel ) ) - ( YEAR ( _Axis ) * 12 + MONTH ( _Axis ) ) )
			RETURN
			    IF ( [L12M Visible Flag] = 1, _Pos )
		formatString: 0
		displayFolder: 10. L12M

	/// Month and year of the axis bar, e.g. "Aug 2026" (tooltip; the axis itself shows only "Aug").
	measure 'L12M Month Label' =
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF ( [L12M Visible Flag] = 1, FORMAT ( _Axis, "mmm yyyy" ) )
		displayFolder: 10. L12M

	/// Chart title text, e.g. "Last 12 months: Sep 2025 - Aug 2026".
	measure 'L12M Title' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    "Last 12 months: " & FORMAT ( EDATE ( _Sel, -11 ), "mmm yyyy" ) & " - " & FORMAT ( _Sel, "mmm yyyy" )
		displayFolder: 10. L12M

	/// Planned Activities for the axis month inside the 12-month window; planned date.
	measure 'L12M Planned' =
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Planned Activities],
			            REMOVEFILTERS ( DimDate ),
			            DATESBETWEEN ( DimDate[ACTUAL_DATE], _Axis, EOMONTH ( _Axis, 0 ) )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// Executed Activities for the axis month inside the window; executed date (USERELATIONSHIP on ExecutedDateKey).
	measure 'L12M Executed' =
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Executed Activities],
			            REMOVEFILTERS ( DimDate ),
			            DATESBETWEEN ( DimDate[ACTUAL_DATE], _Axis, EOMONTH ( _Axis, 0 ) ),
			            USERELATIONSHIP ( DimDate[DATE_KEY], MPO[ExecutedDateKey] )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// PROVISIONAL. Activities With Sales for the axis month inside the window; planned date.
	measure 'L12M Activities With Sales' =
			// PROVISIONAL (Activities With Sales)
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Activities With Sales],
			            REMOVEFILTERS ( DimDate ),
			            DATESBETWEEN ( DimDate[ACTUAL_DATE], _Axis, EOMONTH ( _Axis, 0 ) )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// 1 when the axis month is the selected month (bar 12), else 0.
	measure 'L12M Is Selected Month' =
			IF ( SELECTEDVALUE ( 'L12M Axis'[Month Start] ) = [L12M Selected Month], 1, 0 )
		formatString: 0
		displayFolder: 10. L12M

	/// Planned series colour: light grey, darker grey for the selected month.
	measure 'L12M Bar Colour Planned' =
			IF ( [L12M Is Selected Month] = 1, "#7F7F7F", "#BFBFBF" )
		displayFolder: 10. L12M

	/// Executed series colour: light green, full green for the selected month.
	measure 'L12M Bar Colour Executed' =
			IF ( [L12M Is Selected Month] = 1, "#006341", "#7FB19F" )
		displayFolder: 10. L12M

	/// Sales series colour (PROVISIONAL series): light slate, dark slate for the selected month.
	measure 'L12M Bar Colour Sales' =
			IF ( [L12M Is Selected Month] = 1, "#4A5A6E", "#A9B4C2" )
		displayFolder: 10. L12M

	// ---- Anchor wrappers: KPIs on the BU page follow the 'Month Anchor' slicers.
	// Selected anchor months (or the latest data month when nothing is selected) are
	// mapped onto DimDate[YEAR] + DimDate[MONTH] with TREATAS. Base measures unchanged.

	/// Planned Activities for the anchor selection; planned date.
	measure 'Anchor Planned' =
			VAR _Latest = [L12M Latest Data Month]
			VAR _YM =
			    IF (
			        ISFILTERED ( 'Month Anchor' ),
			        SELECTCOLUMNS ( 'Month Anchor', "Y", 'Month Anchor'[Year], "M", 'Month Anchor'[Month Number] ),
			        { ( YEAR ( _Latest ), MONTH ( _Latest ) ) }
			    )
			RETURN
			    CALCULATE ( [Planned Activities], TREATAS ( _YM, DimDate[YEAR], DimDate[MONTH] ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Executed Activities for the anchor selection; planned date.
	measure 'Anchor Executed' =
			VAR _Latest = [L12M Latest Data Month]
			VAR _YM =
			    IF (
			        ISFILTERED ( 'Month Anchor' ),
			        SELECTCOLUMNS ( 'Month Anchor', "Y", 'Month Anchor'[Year], "M", 'Month Anchor'[Month Number] ),
			        { ( YEAR ( _Latest ), MONTH ( _Latest ) ) }
			    )
			RETURN
			    CALCULATE ( [Executed Activities], TREATAS ( _YM, DimDate[YEAR], DimDate[MONTH] ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Executed (Exec Date) for the anchor selection; executed date (USERELATIONSHIP inside the base measure).
	measure 'Anchor Executed (Exec Date)' =
			VAR _Latest = [L12M Latest Data Month]
			VAR _YM =
			    IF (
			        ISFILTERED ( 'Month Anchor' ),
			        SELECTCOLUMNS ( 'Month Anchor', "Y", 'Month Anchor'[Year], "M", 'Month Anchor'[Month Number] ),
			        { ( YEAR ( _Latest ), MONTH ( _Latest ) ) }
			    )
			RETURN
			    CALCULATE ( [Executed (Exec Date)], TREATAS ( _YM, DimDate[YEAR], DimDate[MONTH] ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// PROVISIONAL. Activities With Sales for the anchor selection; planned date.
	measure 'Anchor Activities With Sales' =
			VAR _Latest = [L12M Latest Data Month]
			VAR _YM =
			    IF (
			        ISFILTERED ( 'Month Anchor' ),
			        SELECTCOLUMNS ( 'Month Anchor', "Y", 'Month Anchor'[Year], "M", 'Month Anchor'[Month Number] ),
			        { ( YEAR ( _Latest ), MONTH ( _Latest ) ) }
			    )
			RETURN
			    CALCULATE ( [Activities With Sales], TREATAS ( _YM, DimDate[YEAR], DimDate[MONTH] ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// PROVISIONAL. Sales Count for the anchor selection; planned date.
	measure 'Anchor Sales Count' =
			VAR _Latest = [L12M Latest Data Month]
			VAR _YM =
			    IF (
			        ISFILTERED ( 'Month Anchor' ),
			        SELECTCOLUMNS ( 'Month Anchor', "Y", 'Month Anchor'[Year], "M", 'Month Anchor'[Month Number] ),
			        { ( YEAR ( _Latest ), MONTH ( _Latest ) ) }
			    )
			RETURN
			    CALCULATE ( [Sales Count], TREATAS ( _YM, DimDate[YEAR], DimDate[MONTH] ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Executed / Planned for the anchor selection.
	measure 'Anchor Execution %' =
			DIVIDE ( [Anchor Executed], [Anchor Planned] )
		formatString: 0.0%
		displayFolder: 10. L12M\Anchor KPIs
