// =============================================================================
// GTM - L12M (rolling last 12 months) on a 'Month Anchor' table. BU page.
// Reworked 2026-11-02 (user request). Replaces the old 'L12M Axis' approach
// (l12m_axis.tmdl is SUPERSEDED). Measures belong to table _mymeasures (home table), folder
// "10. L12M". Counts only. Untested in Power BI.
//
// TABLES (both disconnected: NO relationships)
//   'Month Anchor' - one row per month. Drives the Year and Month slicers.
//   'L12M Axis'    - one row per month, separate copy for the chart X axis.
//                    It must be separate: a slicer on 'Month Anchor' would cut
//                    the axis down to the one selected month.
//   Axis label = 'L12M Axis'[Axis Label]: the short month name ("Aug") plus
//   N invisible zero-width spaces (N = years after the first year), so
//   "Aug" 2025 and "Aug" 2026 are different values that LOOK the same.
//   Sorted by Month Sort Key (YYYYMM), so the axis is always chronological.
//   The visual filter [L12M Visible Flag] = 1 keeps only the 12 months.
//
// BUILD STEPS: see measures_guide.md section 10 (same as the report-back).
// =============================================================================

// ---- Calculated table 1: 'Month Anchor' (Modeling > New table) ---------------
/*
Month Anchor =
VAR _Months =
    DISTINCT (
        SELECTCOLUMNS (
            Dim_Date,
            "Month Start", DATE ( YEAR ( Dim_Date[ACTUAL_DATE] ), MONTH ( Dim_Date[ACTUAL_DATE] ), 1 )
        )
    )
VAR _TodayIdx = YEAR ( TODAY () ) * 12 + MONTH ( TODAY () )
RETURN
    ADDCOLUMNS (
        _Months,
        "Year", YEAR ( [Month Start] ),
        "Month Number", MONTH ( [Month Start] ),
        "Month Short", FORMAT ( [Month Start], "mmm" ),
        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
        "Relative Month Index", YEAR ( [Month Start] ) * 12 + MONTH ( [Month Start] ) - _TodayIdx
    )
*/
// Column settings: Month Short -> Sort by column = Month Number.
// Relative Month Index: 0 = current calendar month AT REFRESH, -1 = previous, etc.

// ---- Calculated table 2: 'L12M Axis' (Modeling > New table) ------------------
/*
L12M Axis =
VAR _Months =
    DISTINCT (
        SELECTCOLUMNS (
            Dim_Date,
            "Month Start", DATE ( YEAR ( Dim_Date[ACTUAL_DATE] ), MONTH ( Dim_Date[ACTUAL_DATE] ), 1 )
        )
    )
VAR _FirstYear = MINX ( _Months, YEAR ( [Month Start] ) )
RETURN
    ADDCOLUMNS (
        _Months,
        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
        "Axis Label",
            FORMAT ( [Month Start], "mmm" )
                & REPT ( UNICHAR ( 8203 ), YEAR ( [Month Start] ) - _FirstYear )
    )
*/
// Column settings: Axis Label -> Sort by column = Month Sort Key; hide Month Sort Key.

// ---- TMDL versions of the two tables -----------------------------------------
/*
table 'Month Anchor'
	lineageTag: month-anchor

	column 'Month Start'
		dataType: dateTime
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: [Month Start]

	column Year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Year]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Number]

	column 'Month Short'
		dataType: string
		summarizeBy: none
		sourceColumn: [Month Short]
		sortByColumn: 'Month Number'

	column 'Month Sort Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Sort Key]

	column 'Relative Month Index'
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [Relative Month Index]

	partition 'Month Anchor' = calculated
		mode: import
		source =
				VAR _Months = DISTINCT ( SELECTCOLUMNS ( Dim_Date, "Month Start", DATE ( YEAR ( Dim_Date[ACTUAL_DATE] ), MONTH ( Dim_Date[ACTUAL_DATE] ), 1 ) ) )
				VAR _TodayIdx = YEAR ( TODAY () ) * 12 + MONTH ( TODAY () )
				RETURN
				    ADDCOLUMNS ( _Months,
				        "Year", YEAR ( [Month Start] ),
				        "Month Number", MONTH ( [Month Start] ),
				        "Month Short", FORMAT ( [Month Start], "mmm" ),
				        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
				        "Relative Month Index", YEAR ( [Month Start] ) * 12 + MONTH ( [Month Start] ) - _TodayIdx )

table 'L12M Axis'
	lineageTag: l12m-axis

	column 'Month Start'
		dataType: dateTime
		isHidden
		formatString: d mmm yyyy
		summarizeBy: none
		sourceColumn: [Month Start]

	column 'Month Sort Key'
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: [Month Sort Key]

	column 'Axis Label'
		dataType: string
		summarizeBy: none
		sourceColumn: [Axis Label]
		sortByColumn: 'Month Sort Key'

	partition 'L12M Axis' = calculated
		mode: import
		source =
				VAR _Months = DISTINCT ( SELECTCOLUMNS ( Dim_Date, "Month Start", DATE ( YEAR ( Dim_Date[ACTUAL_DATE] ), MONTH ( Dim_Date[ACTUAL_DATE] ), 1 ) ) )
				VAR _FirstYear = MINX ( _Months, YEAR ( [Month Start] ) )
				RETURN
				    ADDCOLUMNS ( _Months,
				        "Month Sort Key", YEAR ( [Month Start] ) * 100 + MONTH ( [Month Start] ),
				        "Axis Label", FORMAT ( [Month Start], "mmm" ) & REPT ( UNICHAR ( 8203 ), YEAR ( [Month Start] ) - _FirstYear ) )
*/

// ---- Measures (TMDL, table _mymeasures) ---------------------------------------------
table _mymeasures

	/// Start of the latest month with planned activities, capped at the current month (planned dates can lie in the future). Ignores all date and anchor filters.
	measure 'L12M Latest Data Month' =
			// 2026-11-02 visual 01 review: capped at TODAY() so future-planned activities cannot push the default window past the current month.
			VAR _Through = CALCULATE ( [Data Through Date], REMOVEFILTERS ( Dim_Date ) )
			VAR _Capped  = IF ( NOT ISBLANK ( _Through ), MIN ( _Through, TODAY () ) )
			RETURN
			    IF ( NOT ISBLANK ( _Capped ), DATE ( YEAR ( _Capped ), MONTH ( _Capped ), 1 ) )
		formatString: mmm yyyy
		displayFolder: 10. L12M

	/// Start of the selected anchor month: the latest selected month up to the latest data month (a month-only pick such as "Dec" uses the latest Dec with data). Nothing selected -> latest data month.
	measure 'L12M Selected Month' =
			VAR _Latest = [L12M Latest Data Month]
			VAR _SelUpToLatest =
			    CALCULATE ( MAX ( 'Month Anchor'[Month Start] ), KEEPFILTERS ( 'Month Anchor'[Month Start] <= _Latest ) )
			RETURN
			    IF (
			        ISFILTERED ( 'Month Anchor' ),
			        COALESCE ( _SelUpToLatest, MAX ( 'Month Anchor'[Month Start] ) ),
			        _Latest
			    )
		formatString: mmm yyyy
		displayFolder: 10. L12M

	/// 1 when the axis month is one of the 12 months ending at the selected month (position 12 = selected), else 0. Use as visual filter = 1.
	measure 'L12M Visible Flag' =
			VAR _Sel   = [L12M Selected Month]
			VAR _Start = EDATE ( _Sel, -11 )
			VAR _Axis  = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF ( NOT ISBLANK ( _Axis ) && _Axis >= _Start && _Axis <= _Sel, 1, 0 )
		formatString: 0
		displayFolder: 10. L12M

	/// Position 1..12 of the axis month in the window (12 = selected month); blank outside. For tooltips / QA.
	measure 'L12M Position' =
			VAR _Sel  = [L12M Selected Month]
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			VAR _Pos  = 12 - ( ( YEAR ( _Sel ) * 12 + MONTH ( _Sel ) ) - ( YEAR ( _Axis ) * 12 + MONTH ( _Axis ) ) )
			RETURN
			    IF ( [L12M Visible Flag] = 1, _Pos )
		formatString: 0
		displayFolder: 10. L12M

	/// Month and year of the axis bar, e.g. "Aug 2026" (tooltip; the axis itself shows only "Aug").
	measure 'L12M Month Label' =
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF ( [L12M Visible Flag] = 1, FORMAT ( _Axis, "mmm yyyy" ) )
		displayFolder: 10. L12M

	/// Chart title text, e.g. "Last 12 months: Sep 2025 - Aug 2026".
	measure 'L12M Title' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    "Last 12 months: " & FORMAT ( EDATE ( _Sel, -11 ), "mmm yyyy" ) & " - " & FORMAT ( _Sel, "mmm yyyy" )
		displayFolder: 10. L12M

	/// Planned Activities for the axis month inside the 12-month window; planned date.
	measure 'L12M Planned' =
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Planned Activities],
			            REMOVEFILTERS ( Dim_Date ),
			            DATESBETWEEN ( Dim_Date[ACTUAL_DATE], _Axis, EOMONTH ( _Axis, 0 ) )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// Executed Activities for the axis month inside the window; EXECUTED date (via [Executed (Exec Date)] = USERELATIONSHIP on ExecutedDateKey).
	measure 'L12M Executed' =
			// 2026-11-02 visual 01 review: reuses [Executed (Exec Date)] so the USERELATIONSHIP lives in one place.
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Executed (Exec Date)],
			            REMOVEFILTERS ( Dim_Date ),
			            DATESBETWEEN ( Dim_Date[ACTUAL_DATE], _Axis, EOMONTH ( _Axis, 0 ) )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// PROVISIONAL. Activities With Sales for the axis month inside the window; planned date.
	measure 'L12M Activities With Sales' =
			// PROVISIONAL (Activities With Sales)
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			RETURN
			    IF (
			        [L12M Visible Flag] = 1,
			        CALCULATE (
			            [Activities With Sales],
			            REMOVEFILTERS ( Dim_Date ),
			            DATESBETWEEN ( Dim_Date[ACTUAL_DATE], _Axis, EOMONTH ( _Axis, 0 ) )
			        )
			    )
		formatString: #,0
		displayFolder: 10. L12M

	/// 1 when the axis month is the selected month (bar 12), else 0.
	measure 'L12M Is Selected Month' =
			VAR _Axis = SELECTEDVALUE ( 'L12M Axis'[Month Start] )
			VAR _Sel  = [L12M Selected Month]
			RETURN
			    IF ( NOT ISBLANK ( _Axis ) && NOT ISBLANK ( _Sel ) && _Axis = _Sel, 1, 0 )   -- guard: blank = blank must not count as selected
		formatString: 0
		displayFolder: 10. L12M

	/// Planned series colour: pale green, mid green for the selected month (corporate greens, no grey).
	measure 'L12M Bar Colour Planned' =
			IF ( [L12M Is Selected Month] = 1, "#99C2B3", "#D6E8E0" )
		displayFolder: 10. L12M

	/// Executed series colour: light green, full green for the selected month.
	measure 'L12M Bar Colour Executed' =
			IF ( [L12M Is Selected Month] = 1, "#006341", "#7FB19F" )
		displayFolder: 10. L12M

	/// Sales series colour (PROVISIONAL series): light slate, dark slate for the selected month.
	measure 'L12M Bar Colour Sales' =
			IF ( [L12M Is Selected Month] = 1, "#4A5A6E", "#A9B4C2" )
		displayFolder: 10. L12M

	// ---- Anchor KPIs: ONE pattern for every Anchor measure (refactored 2026-11-02).
	// Helper = [L12M Selected Month] (the chart's last bar): Year+Month -> that month;
	// Year only -> latest data month in that year; nothing selected -> latest data month.
	// Each wrapper: CALCULATE ( [Base], REMOVEFILTERS ( Dim_Date ),
	//     TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) )
	// REMOVEFILTERS(Dim_Date) means any Dim_Date slicer on the page (e.g. the baseline Day
	// slicer) is IGNORED by Anchor measures - remove it from the BU pages.
	// Ratios are DIVIDE of Anchor measures. Base measures are unchanged.

	/// QA helper: YYYYMM of the month all Anchor measures show (= L12M Selected Month).
	measure 'Anchor Month Key' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( NOT ISBLANK ( _Sel ), YEAR ( _Sel ) * 100 + MONTH ( _Sel ) )
		formatString: 0
		displayFolder: 10. L12M\Anchor KPIs

	/// Planned Activities for the anchor month; planned date.
	measure 'Anchor Planned' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Planned Activities],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Executed Activities for the anchor month; PLANNED date (activities planned in the month that were executed).
	measure 'Anchor Executed' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Executed Activities],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Executed activities by the month they were EXECUTED (USERELATIONSHIP on ExecutedDateKey inside the base measure). Can differ from Anchor Executed.
	measure 'Anchor Executed (Exec Date)' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Executed (Exec Date)],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// PROVISIONAL. Activities With Sales for the anchor month; planned date.
	measure 'Anchor Activities With Sales' =
			// PROVISIONAL (Activities With Sales)
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Activities With Sales],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// PROVISIONAL. Sales Count for the anchor month; planned date.
	measure 'Anchor Sales Count' =
			// PROVISIONAL (Sales Count)
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Sales Count],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// PROVISIONAL. Executed No Sale for the anchor month; planned date.
	measure 'Anchor Executed No Sale' =
			// PROVISIONAL (Executed No Sale)
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Executed No Sale],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Executed Activities, same month last year; planned date. Blank for 2025 (no 2024 data).
	measure 'Anchor Executed PY' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Executed PY],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Execution Rate %, same month last year. Blank for 2025 (no 2024 data).
	measure 'Anchor Execution Rate PY' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Execution Rate PY],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10. L12M\Anchor KPIs

	/// Executed minus previous month for the anchor month; planned date.
	measure 'Anchor Executed MoM Diff' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Executed MoM Diff],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: +#,0;-#,0;0
		displayFolder: 10. L12M\Anchor KPIs

	/// Planned - Executed for the anchor month; planned date.
	measure 'Anchor Not Executed' =
			VAR _P = [Anchor Planned]
			RETURN
			    IF ( NOT ISBLANK ( _P ), _P - [Anchor Executed] )
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Alias of Anchor Not Executed (target wording).
	measure 'Anchor Gap to Plan' =
			[Anchor Not Executed]   -- alias, same as Gap to Plan
		formatString: #,0
		displayFolder: 10. L12M\Anchor KPIs

	/// Anchor Executed / Anchor Planned (= Execution Rate % for the anchor month).
	measure 'Anchor Execution %' =
			DIVIDE ( [Anchor Executed], [Anchor Planned] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10. L12M\Anchor KPIs

	/// Anchor Gap to Plan / Anchor Planned.
	measure 'Anchor Gap to Plan %' =
			DIVIDE ( [Anchor Gap to Plan], [Anchor Planned] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10. L12M\Anchor KPIs

	/// PROVISIONAL. Anchor Activities With Sales / Anchor Executed (same definition as Conversion %).
	measure 'Anchor Conversion %' =
			// PROVISIONAL (Conversion %)
			DIVIDE ( [Anchor Activities With Sales], [Anchor Executed] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 10. L12M\Anchor KPIs

	/// Anchor Execution % minus same month last year, in pp.
	measure 'Anchor Execution Rate YoY pp' =
			VAR _C = [Anchor Execution %]
			VAR _P = [Anchor Execution Rate PY]
			RETURN
			    IF ( NOT ISBLANK ( _C ) && NOT ISBLANK ( _P ), _C - _P )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 10. L12M\Anchor KPIs

	/// Anchor Executed minus same month last year (count).
	measure 'Anchor Executed CY vs PY Diff' =
			VAR _C = [Anchor Executed]
			VAR _P = [Anchor Executed PY]
			RETURN
			    IF ( NOT ISBLANK ( _C ) && NOT ISBLANK ( _P ), _C - _P )
		formatString: +#,0;-#,0;0
		displayFolder: 10. L12M\Anchor KPIs

	/// SVG Bullet Executed vs Planned for the anchor month (same image size as the base).
	measure 'Anchor SVG Bullet Executed vs Planned' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [SVG Bullet Executed vs Planned],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		dataCategory: ImageUrl
		displayFolder: 10. L12M\Anchor KPIs

	/// SVG Floating Bar Gap to Plan for the anchor month (same image size as the base).
	measure 'Anchor SVG Floating Bar Gap to Plan' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [SVG Floating Bar Gap to Plan],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		dataCategory: ImageUrl
		displayFolder: 10. L12M\Anchor KPIs

	/// SVG Dumbbell CY vs PY for the anchor month (same image size as the base).
	measure 'Anchor SVG Dumbbell CY vs PY' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [SVG Dumbbell CY vs PY],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		dataCategory: ImageUrl
		displayFolder: 10. L12M\Anchor KPIs

	/// SVG Status Pill for the anchor month (same image size as the base).
	measure 'Anchor SVG Status Pill' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [SVG Status Pill],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		dataCategory: ImageUrl
		displayFolder: 10. L12M\Anchor KPIs

	/// SVG MoM Change Bar for the anchor month (same image size as the base).
	measure 'Anchor SVG MoM Change Bar' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [SVG MoM Change Bar],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		dataCategory: ImageUrl
		displayFolder: 10. L12M\Anchor KPIs

	/// Title - Business Unit for the anchor month (Sel Period reads the anchor month).
	measure 'Anchor Title - Business Unit' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Title - Business Unit],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		displayFolder: 10. L12M\Anchor KPIs

	/// Sparkline of the 12 months ending at the anchor month (same window as the L12M chart); planned date. Image 120x20.
	measure 'Anchor SVG Sparkline Executed' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [SVG Sparkline Executed],
			            REMOVEFILTERS ( Dim_Date ),
			            DATESBETWEEN ( Dim_Date[ACTUAL_DATE], EDATE ( _Sel, -11 ), EOMONTH ( _Sel, 0 ) ) ) )
		dataCategory: ImageUrl
		displayFolder: 10. L12M\Anchor KPIs

	/// Visual filter for month-axis charts on Dim_Date (e.g. BU small multiples): 1 when the Dim_Date month is in the 12 months ending at the anchor month, else 0. Use with no Dim_Date slicer on the page.
	measure 'Anchor L12M Window Flag' =
			// Axis month comes from Dim_Date (row context of the visual axis, e.g. YEAR_MONTH_KEY).
			// Anchor month comes from [L12M Selected Month] = disconnected 'Month Anchor' + REMOVEFILTERS ( Dim_Date ),
			// so the axis filter cannot move the anchor.
			VAR _Sel = [L12M Selected Month]
			VAR _AxisFirst = MIN ( Dim_Date[ACTUAL_DATE] )
			VAR _AxisLast  = MAX ( Dim_Date[ACTUAL_DATE] )
			VAR _AxisMonth = DATE ( YEAR ( _AxisFirst ), MONTH ( _AxisFirst ), 1 )
			VAR _OneMonth  = NOT ISBLANK ( _AxisFirst ) && EOMONTH ( _AxisFirst, 0 ) = EOMONTH ( _AxisLast, 0 )
			RETURN
			    IF ( NOT ISBLANK ( _Sel ) && _OneMonth && _AxisMonth >= EDATE ( _Sel, -11 ) && _AxisMonth <= _Sel, 1, 0 )
		formatString: 0
		displayFolder: 10. L12M\Anchor KPIs

	/// N1 for the anchor month: latest planned date in the anchor month (banner on BU pages).
	measure 'Anchor Data Through Date' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Data Through Date],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: d mmm yyyy
		displayFolder: 10. L12M\Anchor KPIs

	/// N2 for the anchor month: TRUE when the anchor month is the running (partial) month.
	measure 'Anchor Is Partial Month' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Is Partial Month],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: 10. L12M\Anchor KPIs

	/// N8 for the anchor month: "Month to date, through d mmm" when the anchor month is partial, else blank.
	measure 'Anchor Partial Month Label' =
			VAR _Sel = [L12M Selected Month]
			RETURN
			    IF ( ISBLANK ( _Sel ), BLANK (),
			        CALCULATE ( [Partial Month Label],
			            REMOVEFILTERS ( Dim_Date ),
			            TREATAS ( { ( YEAR ( _Sel ), MONTH ( _Sel ) ) }, Dim_Date[YEAR], Dim_Date[MONTH] ) ) )
		displayFolder: 10. L12M\Anchor KPIs
